# ---------------------------------------------------------------------------
# Django core settings
# ---------------------------------------------------------------------------

# REQUIRED when DEBUG=False - the app refuses to start without it.
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=

DEBUG=False

# Comma-separated hostnames this deployment answers to. REQUIRED when
# DEBUG=False. Include the bare IP if you browse to it directly during
# the initial bring-up.
ALLOWED_HOSTS=analytics.medvolt.ai

# Comma-separated scheme+host origins allowed to POST (login, admin).
# These MUST be https:// once USE_HTTPS=True; leave empty until then.
CSRF_TRUSTED_ORIGINS=https://analytics.medvolt.ai

DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# The single switch for every HTTPS-dependent setting: Secure session and
# CSRF cookies, and the HTTP->HTTPS redirect.
#
# Keep this False for the first bring-up over plain HTTP. Browsers refuse
# to store a Secure cookie over http://, so turning it on before a
# certificate is in place makes login fail silently - the site loads, the
# health check passes, and nobody can get past the login form.
#
# Behind Traefik this should be True: Traefik terminates TLS and forwards
# X-Forwarded-Proto: https, which the app is configured to trust. Set
# CSRF_TRUSTED_ORIGINS to the https:// form of DASHBOARD_HOST to match.
USE_HTTPS=True

# HSTS is opt-in and separate: browsers cache the value and it cannot be
# withdrawn quickly. Turn it on (e.g. 31536000) only once HTTPS is proven.
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Routing (Traefik)
# ---------------------------------------------------------------------------

# This stack publishes no host port. Traefik already owns :80 and :443 on
# the instance and routes to us over the shared external Docker network
# "web", terminating TLS with its own Let's Encrypt resolver.
#
# The hostname below becomes the Traefik router rule. It is REQUIRED -
# `docker compose up` refuses to start without it. Its DNS A record must
# already point at this instance, or Let's Encrypt's HTTP-01 challenge
# cannot complete and no certificate is issued.
DASHBOARD_HOST=analytics.medvolt.ai

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite file location. Docker Compose points this at the persistent
# "sqlite_data" volume. Leave unset for local non-Docker runs.
DJANGO_DB_PATH=/app/data/db.sqlite3

# Seconds a query waits for a competing writer before giving up. Guards
# against "database is locked" when a collector runs while the dashboard
# is being used.
SQLITE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Google service account
# ---------------------------------------------------------------------------

# Used by the GA4 / Search Console / Google Sheets collectors. The file is
# NOT baked into the Docker image and NOT committed - place the real
# google_credentials.json next to docker-compose.yml on the host before the
# first `docker compose up`, and chmod 644 it so the non-root container
# user can read it. Compose is configured to fail loudly if it is missing.
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SHEET_NAME=Medvolt_Content_Analytics

# ---------------------------------------------------------------------------
# Collectors
# ---------------------------------------------------------------------------

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_LOOKBACK_DAYS=90
WEBSITE_BASE_URL=https://medvolt.ai

# Google Search Console
# Exact property identifier: sc-domain:medvolt.ai (domain property, all
# subdomains/protocols) is NOT the same as https://www.medvolt.ai/.
SEARCH_CONSOLE_SITE_URL=sc-domain:medvolt.ai
SEARCH_CONSOLE_LOOKBACK_DAYS=90
# Max 25000 (API limit); larger reports are paginated.
SEARCH_CONSOLE_ROW_LIMIT=25000
# Timezone that defines "today" for the Search Console 7/30/90 Days
# presets. Does not change Django's TIME_ZONE (UTC) or Google's Pacific
# Time date labels.
DASHBOARD_TIME_ZONE=Asia/Kolkata
# SEARCH_CONSOLE_END_LAG_DAYS is no longer used: the collector reads the
# latest finalized date from Google (firstIncompleteDate).

# Content discovery
WEBSITE_SITEMAP_URL=https://medvolt.ai/sitemap.xml
SUBSTACK_FEED_URL=

# MailerLite
MAILERLITE_API_KEY=

# Reserved for future use (not currently read by the application)
SLACK_WEBHOOK_URL=
