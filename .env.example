# Django core settings
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_LOG_LEVEL=INFO

# Cookie/TLS hardening (only takes effect when DEBUG=False)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Enable once HTTPS is actually configured in front of the app (e.g. via
# certbot on the host, or a TLS-terminating proxy in front of Nginx).
SECURE_SSL_REDIRECT=False

# SQLite database file location.
# Docker Compose sets this to a path inside the persistent "sqlite_data"
# volume. Leave unset for local (non-Docker) `manage.py runserver` use.
DJANGO_DB_PATH=/app/data/db.sqlite3

# Google service-account credentials used by the GA4 / Search Console /
# Google Sheets collectors. The referenced file is NOT built into the
# Docker image - place it next to docker-compose.yml on the host so it
# can be bind-mounted read-only into the container (see DEPLOYMENT.md).
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SHEET_NAME=Medvolt_Content_Analytics

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_LOOKBACK_DAYS=90
WEBSITE_BASE_URL=https://medvolt.ai

# Google Search Console
SEARCH_CONSOLE_SITE_URL=sc-domain:medvolt.ai
SEARCH_CONSOLE_LOOKBACK_DAYS=90
SEARCH_CONSOLE_END_LAG_DAYS=3
SEARCH_CONSOLE_ROW_LIMIT=25000

# Content discovery
WEBSITE_SITEMAP_URL=https://medvolt.ai/sitemap.xml
SUBSTACK_FEED_URL=

# MailerLite
MAILERLITE_API_KEY=

# Reserved for future use (not currently read by the application)
SLACK_WEBHOOK_URL=
